# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB=SmartCode

# --- Auth (required in production) ---
JWT_SECRET=<random-32+-chars>

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://smartcode.academy
SUPPORT_EMAIL=smartcodeacadem@gmail.com
# Shown on Terms / Privacy / Refund (Paddle account verification).
# Must be real contact details — no placeholders. Email + phone + address required.
NEXT_PUBLIC_SUPPORT_EMAIL=smartcodeacadem@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=+380 96 957 67 23
NEXT_PUBLIC_BUSINESS_ADDRESS=Zastavna, Chernivtsi Oblast, Ukraine
# Pre-sales Support widget channels
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/SmartCode_Academy
NEXT_PUBLIC_SUPPORT_WHATSAPP=https://wa.me/380969576723

# --- Transactional Emails (Resend: Free 3,000 emails/month) ---
RESEND_API_KEY=re_<resend_api_key>
EMAIL_FROM=SmartCode Academy <support@smartcode.academy>

# --- Premium Tier Live Lessons ---
NEXT_PUBLIC_DEFAULT_ZOOM_URL=https://zoom.us/join
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/smartcode-academy

# --- Paddle: server side ---
# 'sandbox' until the live account is approved, then 'production'.
PADDLE_ENV=sandbox
# Dashboard → Developer tools → Authentication
PADDLE_API_KEY=<paddle-api-key>
# Dashboard → Developer tools → Notifications → your webhook destination.
# This signs the webhook. Wrong value means every webhook is rejected and
# nobody ever gets access.
PADDLE_WEBHOOK_SECRET=<paddle-notification-secret>

# --- Paddle: client side (safe to expose) ---
PADDLE_CLIENT_TOKEN_NOTE=client token is public by design; the API key is not
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<paddle-client-side-token>
# Price IDs from Dashboard → Catalog → Products → your prices
# Legacy catalogue SKUs (all programs). Keep for existing subscribers.
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=pri_<monthly_all>
NEXT_PUBLIC_PADDLE_PRICE_ANNUAL=pri_<annual_all>
# Per-program Standard (platform + Discord)
NEXT_PUBLIC_PADDLE_PRICE_ROBLOX_MONTHLY=pri_<roblox_monthly>
NEXT_PUBLIC_PADDLE_PRICE_ROBLOX_ANNUAL=pri_<roblox_annual>
NEXT_PUBLIC_PADDLE_PRICE_PYTHON_MONTHLY=pri_<python_monthly>
NEXT_PUBLIC_PADDLE_PRICE_PYTHON_ANNUAL=pri_<python_annual>
NEXT_PUBLIC_PADDLE_PRICE_AI_MONTHLY=pri_<ai_monthly>
NEXT_PUBLIC_PADDLE_PRICE_AI_ANNUAL=pri_<ai_annual>
# Per-program Premium (adds 2 live lessons / week)
NEXT_PUBLIC_PADDLE_PRICE_ROBLOX_PREMIUM_MONTHLY=pri_<roblox_premium_monthly>
NEXT_PUBLIC_PADDLE_PRICE_ROBLOX_PREMIUM_ANNUAL=pri_<roblox_premium_annual>
NEXT_PUBLIC_PADDLE_PRICE_PYTHON_PREMIUM_MONTHLY=pri_<python_premium_monthly>
NEXT_PUBLIC_PADDLE_PRICE_PYTHON_PREMIUM_ANNUAL=pri_<python_premium_annual>
NEXT_PUBLIC_PADDLE_PRICE_AI_PREMIUM_MONTHLY=pri_<ai_premium_monthly>
NEXT_PUBLIC_PADDLE_PRICE_AI_PREMIUM_ANNUAL=pri_<ai_premium_annual>

# Shown after subscribe when set (private student Discord).
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/r2mBfduASW

# --- Admin bootstrap script ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>
ADMIN_NAME=SmartCode Admin
