# Скопіюйте в .env.local і заповніть реальними значеннями. Не комітьте .env.local.

# --- База даних ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB=SmartCodeLogs

# --- Авторизація сайту (обовʼязково на production) ---
JWT_SECRET=<random-32+-chars>

# --- Скрипт create-admin.js ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>
ADMIN_NAME=SmartCode Academy Admin

# --- Telegram (сповіщення з форм) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram (бот проєктів) ---
TELEGRAM_BOT_TOKEN_PROJECTS=
TELEGRAM_AUTHORIZED_USERS=123456789
TELEGRAM_WEBHOOK_SECRET=

# --- Внутрішні секрети ---
INTERNAL_UPLOAD_SECRET=<random-32+-chars>
INTERNAL_LEAD_SECRET=<random-32+-chars>
LEAD_FORM_SIGNING_SECRET=<random-32+-chars>

# --- Платежі ---
MONOBANK_TOKEN=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# MONOBANK_SKIP_WEBHOOK_VERIFY=true  # лише локально, НІКОЛИ на production

# --- Meta ---
# Pixel ID (публічний). CAPI токен — з Events Manager → Settings → Conversions API → Generate access token
NEXT_PUBLIC_META_PIXEL_ID=1016369117841084
META_CAPI_TOKEN=
# Опційно: тест-код з Events Manager → Test Events (лише для перевірки, не на проді)
# META_CAPI_TEST_EVENT_CODE=

# --- CRM інтеграція (той самий JWT_SECRET що на Railway CRM) ---
CRM_API_URL=https://your-crm-backend.example.com
# CRM_ACCOUNT_NICKNAME=
# CRM_ACCOUNT_PASSWORD=

# --- Публічні URL ---
NEXT_PUBLIC_BASE_URL=https://smartcode-academy.com
API_BASE_URL=https://smartcode-academy.com

# --- Dev only ---
# ALLOW_PUBLIC_SETUP_ROUTES=true
# ENABLE_TELEGRAM_POLLING=true
